# Backend environment variables for Render
# Add these in Render Dashboard -> Your Service -> Environment

ENVIRONMENT=production
DEBUG=false
APP_NAME=Acash AI Interview Assistant
APP_VERSION=1.0.0
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
GOOGLE_CALENDAR_TIMEZONE=Asia/Kolkata
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# ── Fill in these values ──

# Generate a long random string: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_long_random_secret_key_here

ADMIN_TOKEN=your_admin_token_here

# Your Vercel frontend URL (after deploying) - comma-separated if multiple
FRONTEND_URL=https://your-app.vercel.app
CORS_ORIGINS=https://your-app.vercel.app

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/?appName=yourapp

# Gemini API Key from https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# Google Calendar OAuth credentials
GOOGLE_CALENDAR_ID=your_gmail@gmail.com
GOOGLE_CALENDAR_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CALENDAR_CLIENT_SECRET=GOCSPX-your_client_secret
GOOGLE_CALENDAR_REFRESH_TOKEN=1//your_refresh_token

# Vapi credentials from https://dashboard.vapi.ai
VAPI_API_KEY=your_vapi_private_api_key
VAPI_SECRET_TOKEN=
